FROM node:22-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
 && rm -rf /var/lib/apt/lists/*
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build
RUN groupadd --system --gid 1001 insightlab && useradd --system --uid 1001 --gid insightlab insightlab
USER insightlab
EXPOSE 3000
CMD ["npm", "start"]
