# --- LLM provider (OPTIONAL) ---
# Unset => LocalPlanner (deterministic, fully functional, no network).
# Set    => AnthropicPlanner, which falls back to LocalPlanner on any error.
LLM_PROVIDER=local              # local | anthropic
ANTHROPIC_API_KEY=              # server-side only; never exposed to the browser
LLM_MODEL=claude-sonnet-4-6
LLM_TIMEOUT_MS=20000

# --- Python analysis service (OPTIONAL) ---
# Unset => Python code is generated and statically validated but not executed.
# Use 127.0.0.1, not localhost: Node resolves localhost to ::1 first and
# uvicorn binds IPv4 by default, which produces a silent 'fetch failed'.
PYTHON_SERVICE_URL=http://127.0.0.1:8000

# --- Limits ---
MAX_UPLOAD_BYTES=5242880
MAX_QUERY_ROWS=1000
QUERY_TIMEOUT_MS=10000
PYTHON_TIMEOUT_MS=15000
