# --- AI (optional) -----------------------------------------------------------
# With ANTHROPIC_API_KEY set, Claude plans each analysis and writes the
# interpretation; all numbers are still computed by SQL. Without a key the
# built-in rule-based planner is used and the UI says so.
#   LLM_PROVIDER: unset = use Anthropic when a key is present; "local" = never call an AI service.
LLM_PROVIDER=
ANTHROPIC_API_KEY=              # server-side only; never sent to the browser
LLM_MODEL=claude-opus-5-5
LLM_TIMEOUT_MS=60000
# LLM_BASE_URL=https://api.anthropic.com   # only for a proxy/gateway; ANTHROPIC_BASE_URL is deliberately ignored

# --- Storage ------------------------------------------------------------------
# Imported datasets and their saved analyses live here, one folder per dataset,
# and are deleted automatically after DATASET_RETENTION_HOURS.
DATA_DIR=./.data
DATASET_RETENTION_HOURS=24
MAX_DATASETS=50

# --- Limits -------------------------------------------------------------------
MAX_UPLOAD_BYTES=26214400        # 25 MB
MAX_ROWS=250000
MAX_COLUMNS=250
MAX_QUERY_ROWS=1000              # rows returned per query / analysis result
QUERY_TIMEOUT_MS=10000

# --- Pandas cross-check service (optional, Linux/Docker only) -----------------
# When set, aggregate answers are recomputed with pandas in the sandboxed
# service and compared with the SQL result. Use 127.0.0.1, not localhost.
# PYTHON_SERVICE_URL=http://127.0.0.1:8000
PYTHON_TIMEOUT_MS=15000
